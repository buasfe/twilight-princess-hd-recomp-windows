// Version information and application manifest of @WWHD_RC_ORIGINAL@ (generated from cmake/windows/app.rc.in
// by cmake/WindowsResources.cmake).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION @WWHD_RC_VERSION_COMMAS@
PRODUCTVERSION @WWHD_RC_VERSION_COMMAS@
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "Twilight Princess HD Recompiled contributors"
      VALUE "FileDescription", "@WWHD_RC_DESCRIPTION@"
      VALUE "FileVersion", "@WWHD_RC_VERSION_STRING@"
      VALUE "InternalName", "@WWHD_RC_INTERNAL@"
      VALUE "LegalCopyright", "AsadSi, ZeldaWWHDRecomp and the Windows Edition contributors. Source code under MPL-2.0."
      VALUE "OriginalFilename", "@WWHD_RC_ORIGINAL@"
      VALUE "ProductName", "Twilight Princess HD Recompiled - Windows Edition"
      VALUE "ProductVersion", "@WWHD_RC_VERSION_STRING@"
      VALUE "Comments", "Unofficial Windows preview. Build locally using your own Wii U game dump."
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
@WWHD_RC_MANIFEST_LINE@
